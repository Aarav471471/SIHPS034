# ==========================================================================
#  MetriX - Environment Configuration
#  Copy to `.env` and fill in.  `.env` is gitignored - never commit secrets.
# ==========================================================================

ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------- DATABASE
# Zero-install default (SQLite). Leave blank to use it.
# DATABASE_URL=sqlite+aiosqlite:///./metrix.db
# Production / docker-compose:
# DATABASE_URL=postgresql+asyncpg://metrix:metrix@localhost:5432/metrix

# ------------------------------------------------------------ TASK QUEUE
# inprocess = no Redis required (dev) | celery = Redis event bus (spec/prod)
TASK_BACKEND=inprocess
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------- STORAGE
# local = filesystem ./storage | minio = S3-compatible object store
STORAGE_BACKEND=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=metrix
MINIO_SECRET_KEY=metrix-secret
MINIO_BUCKET=metrix-evidence

# -------------------------------------------------------------- SECURITY
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-generate-a-real-secret-before-deploying

# ------------------------------------------------------------- VISION AI
# claude = Claude Vision (primary) | gemini = Gemini Vision | mock = offline demo
VISION_PROVIDER=mock
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# NVIDIA NIM -- free credits from build.nvidia.com, OpenAI-compatible.
# Set VISION_PROVIDER=nvidia to use it.
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct


# ------------------------------------------------------------------- OCR
# auto probes paddle -> rapidocr -> tesseract -> deterministic verifier
OCR_ENGINE=auto

# ------------------------------------------------------------------- PDF
# auto prefers weasyprint when installed, else reportlab
PDF_ENGINE=auto

# ------------------------------------------------------------------ CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8081
