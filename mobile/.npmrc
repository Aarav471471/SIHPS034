# Expo SDK 57 pins react@19.2.3 while a transitive react-dom@19.2.8 asks for
# react@^19.2.8. npm's strict peer resolution refuses the tree outright; Expo's
# own installer tolerates it. Setting this here keeps every later `npm install`
# consistent with how the lockfile was built, instead of half-pruning the tree.
legacy-peer-deps=true
